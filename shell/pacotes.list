# DuiaOS — pacotes da interface gráfica: Tela de Entrada e de Bloqueio, sessão,
# Barra de Recursos, Ilha de Aplicativos, Menu de Energia, Explorador de Arquivos,
# Configurações, Duia App Store e animação de boot.
# Esta lista entra na ISO (build/build.sh a copia para config/package-lists).
# Instalação manual: sudo apt install -y $(grep -v '^#' shell/pacotes.list)

# Tela de Entrada: gerenciador de login (greetd) e compositor de tela única (cage)
greetd
cage

# Tela de Bloqueio: conferência da senha (PAM), bloqueio automático e reserva
python3-pamela
swayidle
swaylock

# Sessão do usuário: D-Bus por sessão e permissões (polkit)
dbus-user-session
polkitd

# Animação de boot e de desligamento
plymouth

# Compositor, terminal, fundo e telas
labwc
foot
swaybg
wlr-randr

# Janelas abertas e foco (usado pela Ilha de Aplicativos)
wlrctl

# Acessibilidade (AT-SPI), captura de tela e teclado virtual (ADR 035):
# leitores de tela e o Wise usando o computador
at-spi2-core
# Menu do aplicativo em foco na Barra (ADR 057): o Python lê os menus pelo AT-SPI
gir1.2-atspi-2.0
# Botões da barra de título dos aplicativos GTK e dos navegadores (ADR 058): 90_duiaos.gschema.override
gsettings-desktop-schemas
grim
wtype

# Qt6 / QML no Wayland e o módulo de painéis (layer-shell)
qt6-wayland
qt6-svg-plugins
qml6-module-org-kde-layershell
qml6-module-qtqml
qml6-module-qtqml-models
qml6-module-qtqml-workerscript
qml6-module-qtquick
qml6-module-qtquick-controls
qml6-module-qtquick-layouts
qml6-module-qtquick-window

# Python para a lógica da interface
python3-pyside6.qtquick
python3-pyside6.qtqml
python3-pyside6.qtgui
python3-pyside6.qtsvg

# Controles da Barra de Recursos, da Central de Controle e das Configurações:
# brilho (pelo logind), luz noturna, modos de energia, permissões (pkexec)
brightnessctl
wlsunset
power-profiles-daemon
pkexec

# Explorador de Arquivos: pastas do usuário, abrir arquivos, discos e pendrives
xdg-user-dirs
xdg-utils
udisks2
# Descompactar .7z e .rar (o .zip e o .tar.* usam o próprio Python; ADR 067)
7zip

# Área de Trabalho e Tela de Descanso: vídeos de fundo (QtMultimedia, com FFmpeg) e escolha de
# arquivos (FileDialog do Qt Quick, sem portal)
qml6-module-qtmultimedia
qml6-module-qtquick-effects
qml6-module-qtquick-dialogs
qml6-module-qtquick-templates
qml6-module-qt-labs-folderlistmodel

# Notificações (serviço org.freedesktop.Notifications pelo GLib) e notify-send; Configurações e
# Barra falam com o agente do sistema e com as notificações pelo D-Bus
python3-gi
gir1.2-glib-2.0
libnotify-bin
python3-pyside6.qtdbus

# Ícones e fontes
hicolor-icon-theme
fonts-inter
fonts-manrope
fonts-jetbrains-mono

# Duia App Store (ADR 049): aplicativos do Flathub (flatpak, sem senha, na conta da
# pessoa) e do Debian (metadados AppStream/DEP-11 e ícones baixados pelo apt)
flatpak
appstream
apt-config-icons
python3-yaml
# Cofre do sistema: chaves dos motores de IA na nuvem (Configurações › Inteligência Artificial)
python3-secretstorage
gnome-keyring
