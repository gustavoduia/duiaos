# DuiaOS — programas iniciados junto com a sessão gráfica (labwc).
# Instalação para teste: cp shell/sessao/autostart ~/.config/labwc/autostart
DUIAOS="$HOME/Projetos/duiaos"

# Fundo da tela (Azul névoa; o papel de parede próprio vem depois)
swaybg -c '#E8F0FE' >/dev/null 2>&1 &

# Painel superior do DuiaOS
python3 "$DUIAOS/shell/painel/main.py" >/tmp/duiaos-painel.log 2>&1 &

# Terminal para desenvolvimento
foot >/dev/null 2>&1 &
