#!/bin/sh
# =============================================================================
# DuiaOS — inicia a sessão gráfica (compositor labwc + interface do DuiaOS).
#
# Chamado pela Tela de Entrada depois da senha correta (e, no modo live,
# direto pelo greetd). A configuração do labwc fica em /etc/xdg/labwc
# (autostart, environment, rc.xml); um arquivo com o mesmo nome em
# ~/.config/labwc substitui o do sistema.
# =============================================================================
export XDG_SESSION_TYPE=wayland
export XDG_SESSION_DESKTOP=duiaos
export XDG_CURRENT_DESKTOP=DuiaOS:wlroots

# Pasta da interface. Para testar o código do repositório, defina em
# ~/.config/labwc/environment: DUIAOS_SHELL=/home/USUARIO/Projetos/duiaos/shell
export DUIAOS_SHELL="${DUIAOS_SHELL:-/usr/share/duiaos/shell}"

# Teclado igual ao do sistema (/etc/default/keyboard; padrão ABNT2)
if [ -r /etc/default/keyboard ]; then
  # shellcheck source=/dev/null
  . /etc/default/keyboard
fi
export XKB_DEFAULT_MODEL="${XKBMODEL:-abnt2}"
export XKB_DEFAULT_LAYOUT="${XKBLAYOUT:-br}"
export XKB_DEFAULT_VARIANT="${XKBVARIANT:-}"
export XKB_DEFAULT_OPTIONS="${XKBOPTIONS:-}"

# Aplicativos do Flathub (Duia App Store, ADR 049): os atalhos e ícones que o flatpak
# exporta entram na Central de Aplicativos, no "Abrir com" e no tema de ícones
DADOS_FLATPAK="${XDG_DATA_HOME:-$HOME/.local/share}/flatpak/exports/share:/var/lib/flatpak/exports/share"
export XDG_DATA_DIRS="${DADOS_FLATPAK}:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

# Aplicativos Qt e GTK usam o Wayland
export QT_QPA_PLATFORM=wayland
export MOZ_ENABLE_WAYLAND=1

# Nada de texto de terminal na tela (ADR 054 e 055): limpa o terminal virtual, esconde o
# cursor e manda as mensagens dos programas para um arquivo (ou para lugar nenhum), em vez
# de deixá-las no terminal por baixo da interface.
# IMPORTANTE: só redirecionamento do próprio shell, que não tem como falhar. Nunca ponha um
# programa na frente do compositor aqui (como o systemd-cat): se ele falhar, a tela gráfica
# não abre e a pessoa cai no login em modo texto (aconteceu em 16/11).
{ printf '\033[H\033[2J\033[3J\033[?25l' > /dev/tty; } 2>/dev/null || true
REGISTRO="${XDG_RUNTIME_DIR:-}/duiaos-sessao.log"
# O teste roda num subshell: num shell POSIX, um redirecionamento que falha em ":" ou "exec" encerra o script
if [ -n "${XDG_RUNTIME_DIR:-}" ] && ( : > "${REGISTRO}" ) 2>/dev/null; then
  exec >> "${REGISTRO}" 2>&1
else
  exec > /dev/null 2>&1
fi

exec labwc
