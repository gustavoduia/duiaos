<?xml version="1.0"?>
<!--
  DuiaOS — configuração do compositor labwc.
  Instalação para teste: cp shell/sessao/rc.xml ~/.config/labwc/rc.xml
-->
<labwc_config>
  <keyboard>
    <!-- Mantém os atalhos padrão do labwc -->
    <default />
    <!-- Super + Espaço: abre e fecha a Central de Aplicativos -->
    <keybind key="W-space">
      <action name="Execute" command="sh -c &quot;$HOME/Projetos/duiaos/shell/ilha-de-aplicativos/alternar-central.sh&quot;" />
    </keybind>
  </keyboard>
</labwc_config>
