<?xml version="1.0"?>
<!--
  DuiaOS — configuração do compositor labwc.
  Instalado em /etc/xdg/labwc/rc.xml (um ~/.config/labwc/rc.xml o substitui).
  DUIAOS_SHELL vem de iniciar-sessao (padrão /usr/share/duiaos/shell).
-->
<labwc_config>
  <!-- Janelas no estilo do macOS: tema DuiaOS (/usr/share/themes/DuiaOS), bolinhas à esquerda
       (fechar, minimizar, maximizar) e título no centro -->
  <theme>
    <name>DuiaOS</name>
    <titlebar>
      <layout>close,iconify,max:</layout>
      <showTitle>yes</showTitle>
    </titlebar>
    <font place=""><name>Inter</name><size>10</size><weight>Bold</weight></font>
    <font place="ActiveWindow"><name>Inter</name><size>10</size><weight>Bold</weight></font>
    <font place="InactiveWindow"><name>Inter</name><size>10</size><weight>Bold</weight></font>
    <font place="MenuItem"><name>Inter</name><size>10</size></font>
    <font place="OnScreenDisplay"><name>Inter</name><size>10</size></font>
    <cornerRadius>10</cornerRadius>
    <dropShadows>yes</dropShadows>
  </theme>
  <!-- Cliques na área de trabalho são da Área de Trabalho do DuiaOS (esquerdo seleciona e abre,
       direito abre o menu de contexto); o labwc não abre mais o menu dele (Reconfigurar/Sair). -->
  <mouse>
    <default />
    <context name="Root">
      <mousebind button="Left" action="Press"><action name="None" /></mousebind>
      <mousebind button="Right" action="Press"><action name="None" /></mousebind>
      <mousebind button="Middle" action="Press"><action name="None" /></mousebind>
    </context>
  </mouse>
  <keyboard>
    <!-- Mantém os atalhos padrão do labwc -->
    <default />
    <!-- Super + Espaço: abre e fecha a Central de Aplicativos -->
    <keybind key="W-space">
      <action name="Execute" command="sh -c &quot;$DUIAOS_SHELL/ilha-de-aplicativos/alternar-central.sh&quot;" />
    </keybind>
    <!-- Super + W: abre e fecha o Wise (se estiver instalado) -->
    <keybind key="W-w">
      <action name="Execute" command="sh -c &quot;[ -x /usr/bin/duiaos-wise ] &amp;&amp; /usr/bin/duiaos-wise --alternar&quot;" />
    </keybind>
    <!-- Super + E: Explorador de Arquivos -->
    <keybind key="W-e">
      <action name="Execute" command="sh -c &quot;command -v duiaos-explorador-de-arquivos &gt;/dev/null &amp;&amp; exec duiaos-explorador-de-arquivos || exec python3 $DUIAOS_SHELL/../explorador-de-arquivos/main.py&quot;" />
    </keybind>
    <!-- Super + L: bloqueia a tela -->
    <keybind key="W-l">
      <action name="Execute" command="sh -c &quot;$DUIAOS_SHELL/bloqueio/bloquear&quot;" />
    </keybind>
    <!-- Ctrl + Alt + Delete: Menu de Energia -->
    <keybind key="C-A-Delete">
      <action name="Execute" command="sh -c &quot;python3 $DUIAOS_SHELL/menu-de-energia/main.py&quot;" />
    </keybind>
  </keyboard>
</labwc_config>
