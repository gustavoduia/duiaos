#!/bin/sh
# =============================================================================
# DuiaOS — prepara a configuração do greetd (Tela de Entrada).
#
# Executado pelo systemd antes do greetd (greetd.service.d/duiaos.conf).
# Copia /etc/greetd/config.toml para /run/duiaos/greetd.toml e, no modo live
# (pendrive), acrescenta a entrada automática do usuário live: a pessoa vê
# a área de trabalho do DuiaOS sem digitar senha. No sistema instalado,
# a Tela de Entrada sempre pede a senha.
# =============================================================================
set -e

install -d -m 0755 /run/duiaos
install -m 0644 /etc/greetd/config.toml /run/duiaos/greetd.toml

if grep -qw 'boot=live' /proc/cmdline; then
  USUARIO="$(sed -n 's/.*\busername=\([^ ]*\).*/\1/p' /proc/cmdline)"
  USUARIO="${USUARIO:-duia}"
  if id "${USUARIO}" >/dev/null 2>&1; then
    cat >> /run/duiaos/greetd.toml <<FIM

# Modo live: entra direto na sessão do usuário ${USUARIO}
[initial_session]
command = "/usr/share/duiaos/shell/sessao/iniciar-sessao"
user = "${USUARIO}"
FIM
  fi
fi
