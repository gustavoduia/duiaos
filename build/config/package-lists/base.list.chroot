# DuiaOS — pacotes comuns a todas as arquiteturas.
# Um pacote por linha. Linhas com # são comentários.

# Sistema básico
sudo
locales
console-setup
keyboard-configuration
tzdata
bash-completion
nano
less
man-db

# Rede (nmtui: configuração de Wi-Fi e cabo no terminal)
network-manager
iw
wireless-regdb
ca-certificates
curl
wget
systemd-timesyncd

# Acesso remoto (SSH) e nome na rede local (duiaos.local)
openssh-server
avahi-daemon
libnss-mdns

# Desenvolvimento
git

# Bluetooth
bluez

# Áudio: PipeWire (servidor de som) e ferramentas de teste
pipewire-audio
alsa-utils

# Memória: swap comprimida na RAM (zram)
zram-tools

# Sistemas de arquivos usados na instalação (EFI, btrfs) e detecção de
# outros sistemas para dual boot (os-prober)
dosfstools
os-prober
btrfs-progs

# Diagnóstico de hardware (ex.: lspci -nn)
pciutils
usbutils

# Firmware livre
firmware-linux-free
