# DuiaOS — pacotes comuns a todas as arquiteturas.
# Um pacote por linha. Linhas com # são comentários.

# Sistema básico
sudo
locales
console-setup
keyboard-configuration
tzdata
bash-completion
nano
less
man-db

# Rede (nmtui: configuração de Wi-Fi e cabo no terminal)
network-manager
iw
wireless-regdb
ca-certificates
curl
wget
systemd-timesyncd

# Acesso remoto (SSH) e nome na rede local (duiaos.local)
openssh-server
avahi-daemon
libnss-mdns

# Desenvolvimento
git

# Bluetooth
bluez

# Áudio: PipeWire (servidor de som) e ferramentas de teste
pipewire-audio
alsa-utils

# Memória: swap comprimida na RAM (zram)
zram-tools

# Sistemas de arquivos usados na instalação (EFI, btrfs) e detecção de
# outros sistemas para dual boot (os-prober)
dosfstools
os-prober
efibootmgr
btrfs-progs

# Diagnóstico de hardware (ex.: lspci -nn)
pciutils
usbutils

# Firmware
firmware-linux-free
# Som e microfone dos notebooks Intel recentes (Sound Open Firmware): sem ele, o microfone embutido
# (DMIC) não aparece e o Wise não consegue ouvir (ADR 065)
firmware-sof-signed
alsa-ucm-conf

# Instalador do DuiaOS (ADR 064): Calamares, com os passos do Debian 13; a identidade vem do
# duiaos-fontes-abertas (instalador/). O instalador do Debian (d-i) não vai mais na ISO (ADR 065).
calamares
calamares-settings-debian
qml6-module-qtquick
qml6-module-qtqml
qml6-module-qtquick-effects
qt6-svg-plugins
# O instalador (Calamares) roda pelo Xwayland: no Wayland nativo os campos não recebem o teclado
xwayland
x11-xserver-utils
rsync
squashfs-tools
