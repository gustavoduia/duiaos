#!/bin/sh
# DuiaOS — textos do menu de boot (GRUB) em português e com o nome DuiaOS.
# Roda depois que o live-build monta o menu, antes de gerar a ISO.
set -e

if [ -d boot/grub ]; then
  GRUB_DIR=boot/grub
elif [ -d binary/boot/grub ]; then
  GRUB_DIR=binary/boot/grub
else
  echo "Pasta do GRUB não encontrada; menu não traduzido." >&2
  exit 0
fi

sed -i \
  -e 's/Live system (autodetect)/DuiaOS — modo live/g' \
  -e 's/Live system, kernel/DuiaOS — modo live, kernel/g' \
  -e 's/Live system (\([a-z0-9]*\) fail-safe mode)/DuiaOS — modo de segurança (\1)/g' \
  -e 's/Live system (\([a-z0-9]*\))/DuiaOS — modo live (\1)/g' \
  -e 's/(fail-safe mode)/(modo de segurança)/g' \
  -e "s/'Utilities\.\.\.'/'Utilitários...'/g" \
  -e 's/"UEFI Firmware Settings"/"Configurações do firmware UEFI"/g' \
  -e 's/"Verify integrity of the boot medium"/"Verificar a integridade da mídia"/g' \
  -e "s/'Start installer with speech synthesis'/'Instalar o DuiaOS com síntese de voz'/g" \
  -e "s/'Start installer'/'Instalar o DuiaOS'/g" \
  -e "s/'Advanced install options \.\.\.'/'Opções avançadas de instalação...'/g" \
  -e "s/'Graphical installer with dark theme \.\.\.'/'Instalador gráfico com tema escuro...'/g" \
  -e "s/'Text installer with dark theme \.\.\.'/'Instalador em texto com tema escuro...'/g" \
  -e "s/'Graphical installer \.\.\.'/'Instalador gráfico...'/g" \
  -e "s/'Text installer \.\.\.'/'Instalador em texto...'/g" \
  -e "s/'Installer with speech synthesis \.\.\.'/'Instalador com síntese de voz...'/g" \
  -e "s/'Install'/'Instalar'/g" \
  -e "s/'Expert install'/'Instalação avançada'/g" \
  -e "s/'Automated install'/'Instalação automática'/g" \
  -e "s/'Rescue mode'/'Modo de recuperação'/g" \
  "${GRUB_DIR}"/*.cfg

# Segunda entrada do modo live com teclado americano (US), útil em
# máquinas virtuais no Mac e em teclados importados. É uma cópia da
# primeira entrada "modo live", logo abaixo dela, trocando o layout.
awk '
  !feito && /^menuentry "DuiaOS — modo live \(/ { copiando = 1 }
  { print }
  copiando {
    linha = $0
    sub(/modo live \(/, "modo live, teclado US (", linha)
    sub(/ --hotkey=l/, "", linha)
    gsub(/keyboard-layouts=br/, "keyboard-layouts=us", linha)
    bloco = bloco linha "\n"
    if ($0 ~ /^}/) { printf "\n%s", bloco; copiando = 0; feito = 1 }
  }
' "${GRUB_DIR}/grub.cfg" > "${GRUB_DIR}/grub.cfg.novo"
mv "${GRUB_DIR}/grub.cfg.novo" "${GRUB_DIR}/grub.cfg"
