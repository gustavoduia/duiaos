---
// DuiaOS — página de downloads. Mostra a versão mais recente (dados de
// src/dados/versoes.json, atualizados no navegador pelo /api/versoes, que lê os
// Releases do repositório público e guarda no KV por 30 minutos).
import Site from "../layouts/Site.astro";
import dados from "../dados/versoes.json";
const v = dados.versoes[0];
const data = new Date(v.data + "T12:00:00").toLocaleDateString("pt-BR", { day: "numeric", month: "long", year: "numeric" });
---
<Site title="Baixar o DuiaOS" description="Baixe a imagem do DuiaOS para Intel, AMD ou ARM e crie um pendrive de instalação.">
  <div class="pagina">
    <header>
      <h1>Baixar o DuiaOS</h1>
      <p class="chamada-texto">Versão <span data-campo="versao">{v.versao}</span>, de{" "}<span data-campo="data">{data}</span>{" "}<span data-campo="canal">({v.canal})</span>. Grátis para baixar e testar.</p>
    </header>

    <section class="downloads" aria-label="Arquivos para baixar" data-lista-isos>
      {v.isos.map((iso) => (
        <a class="download" href={iso.url}>
          <span class="arq">{iso.rotulo}</span>
          <span class="nome">{iso.nome}</span>
          <span class="acao">Baixar</span>
        </a>
      ))}
    </section>
    <p class="verificar">Não sabe qual escolher? Quase todos os notebooks e computadores de mesa usam{" "}<strong>Intel e AMD</strong>. Para conferir o arquivo baixado, use as somas sha256 da{" "}<a data-campo="pagina" href={v.pagina}>página da versão</a>.</p>

    <section class="passos">
      <h2>Depois de baixar</h2>
      <ol>
        <li><h3>Grave num pendrive</h3><p>Use um pendrive de 8 GB ou mais e um gravador de imagens, como o balenaEtcher
          ou o Rufus no Windows. Tudo o que estiver no pendrive será apagado.</p></li>
        <li><h3>Ligue pelo pendrive</h3><p>Com o pendrive conectado, ligue o computador e abra o menu de boot
          (<kbd>F12</kbd> nos Dell, <kbd>F9</kbd> nos HP, <kbd>F12</kbd> ou <kbd>F2</kbd> em outros).</p></li>
        <li><h3>Experimente ou instale</h3><p>Use o DuiaOS direto do pendrive, sem mudar nada, ou instale ao lado do
          Windows seguindo o <a href="/documentacao/comecar/instalar-ao-lado-do-windows/">guia de instalação</a>.</p></li>
      </ol>
    </section>

    <section class="requisitos">
      <h2>O que o computador precisa</h2>
      <p>Processador de 64 bits, 8 GB de memória (16 GB recomendados para a IA), 30 GB livres no disco e firmware
        UEFI. Veja os <a href="/documentacao/referencia/requisitos/">requisitos completos</a>.</p>
    </section>
  </div>
</Site>

<style is:global>
  /* global: os cartões podem ser recriados pelo script (versão nova) */
  .downloads { display: grid; grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr)); gap: 1rem; }
  .download {
    display: grid; gap: .25rem; padding: 1.5rem 1.6rem; border-radius: 22px; text-decoration: none;
    background: var(--branco); box-shadow: inset 0 0 0 1.5px var(--linha); transition: box-shadow .2s, transform .2s;
  }
  .download:hover { box-shadow: inset 0 0 0 2px var(--azul); transform: translateY(-2px); }
  .arq { font-family: var(--titulo); font-weight: 800; font-size: 1.4rem; letter-spacing: -0.02em; }
  .nome { color: var(--texto-suave); font-size: .9rem; }
  .acao { margin-top: .9rem; justify-self: start; background: var(--azul); color: #fff; font-weight: 600;
          padding: .55rem 1.2rem; border-radius: 999px; font-size: .95rem; }
  .verificar { margin-top: 1.2rem; color: var(--texto-suave); font-size: .95rem; max-width: 46em; }
  .verificar a, .passos a, .requisitos a { color: var(--azul); }
  .passos { margin-top: 5rem; display: grid; gap: 2rem; }
  .passos ol { list-style: none; counter-reset: passo; margin: 0; padding: 0;
               display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; }
  .passos li { counter-increment: passo; display: grid; gap: .6rem; align-content: start; }
  .passos li::before { content: counter(passo); font-family: var(--titulo); font-weight: 800; font-size: 2.5rem;
                       color: var(--azul); line-height: 1; }
  .passos p, .requisitos p { color: var(--texto-suave); }
  .requisitos { margin-top: 5rem; display: grid; gap: 1rem; }
  kbd { font: inherit; font-size: .82em; padding: .05em .4em; border-radius: 6px; border: 1px solid var(--linha); border-bottom-width: 2px; }
  @media (max-width: 760px) { .passos ol { grid-template-columns: 1fr; } }
</style>

<script>
  // Atualiza com a versão mais nova publicada, se o /api/versoes responder
  async function atualizar() {
    try {
      const resposta = await fetch("/api/versoes", { headers: { accept: "application/json" } });
      if (!resposta.ok) return;
      const { versoes } = await resposta.json();
      const v = versoes?.[0];
      if (!v?.isos?.length) return;
      const campo = (n) => document.querySelector(`[data-campo="${n}"]`);
      campo("versao").textContent = v.versao;
      campo("data").textContent = new Date(v.data).toLocaleDateString("pt-BR", { day: "numeric", month: "long", year: "numeric" });
      campo("canal").textContent = v.canal ? `(${v.canal})` : "";
      campo("pagina").setAttribute("href", v.pagina);
      const lista = document.querySelector("[data-lista-isos]");
      lista.replaceChildren(...v.isos.map((iso) => {
        const a = document.createElement("a");
        a.className = "download";
        a.href = iso.url;
        for (const [classe, texto] of [["arq", iso.rotulo], ["nome", iso.nome], ["acao", "Baixar"]]) {
          const s = document.createElement("span");
          s.className = classe;
          s.textContent = texto;
          a.append(s);
        }
        return a;
      }));
    } catch {
      /* sem a API: fica a versão publicada com o site */
    }
  }
  atualizar();
</script>
