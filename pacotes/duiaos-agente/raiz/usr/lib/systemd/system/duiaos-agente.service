[Unit]
Description=Agente do sistema do DuiaOS (ações aprovadas: atualizar, instalar, remover)

# Aberto pelo D-Bus quando um programa pede (org.duiaos.Agente1); sai sozinho
# depois de 10 minutos sem uso. Roda como root porque o apt precisa.
[Service]
Type=dbus
BusName=org.duiaos.Agente1
ExecStart=/usr/bin/python3 /usr/share/duiaos/agente/agente.py
LogsDirectory=duiaos-agente
LogsDirectoryMode=0750
UMask=0022
# Sem reiniciar sozinho no meio de uma instalação: o apt não pode ser morto, e o agente só sai
# depois de terminar a tarefa (ele adia o SIGTERM; ADR 047)
KillMode=process
TimeoutStopSec=60min
# Sem isolamento (PrivateTmp, ProtectHome, ProtectKernelTunables…): quem instala pacotes precisa do
# sistema de verdade. Com PrivateTmp, o /tmp do apt sumia quando o serviço parava no meio da
# atualização e os scripts dos pacotes falhavam (ca-certificates: "mktemp: No such file", 14/11/2026).
