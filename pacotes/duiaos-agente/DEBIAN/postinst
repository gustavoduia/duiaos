#!/bin/sh
# DuiaOS — duiaos-agente: recarrega o D-Bus e o systemd (o serviço abre sob demanda).
set -e
if [ "$1" = "configure" ] && [ -d /run/systemd/system ]; then
  systemctl daemon-reload || true
  systemctl reload dbus.service >/dev/null 2>&1 || true
  # Atualização automática (ADR 058): o modo vem de /etc/duiaos/atualizacoes.conf (padrão: baixar)
  systemctl enable --now duiaos-atualizacao-automatica.timer >/dev/null 2>&1 || true
  # Nunca reiniciar o agente aqui: muitas vezes é ele mesmo que está rodando este apt (atualizar o
  # sistema pela Central de Atualizações) e parar o serviço no meio derrubava a atualização. A versão
  # antiga percebe que foi trocada e sai sozinha quando termina; o D-Bus abre a nova no próximo pedido.
fi
if [ "$1" = "configure" ]; then
  # Firewall (ADR 071), uma vez: as conexões que já existem ficam privadas (o SSH em uso continua) e só
  # depois a zona padrão vira a pública; na construção da ISO (chroot, firewalld parado) grava só a zona
  # padrão. Falhar aqui não pode quebrar a atualização.
  python3 /usr/share/duiaos/agente/firewall.py preparar || true
fi
exit 0
