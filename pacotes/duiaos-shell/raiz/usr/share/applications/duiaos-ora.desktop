[Desktop Entry]
Type=Application
Name=Ora
GenericName=Navegador
Comment=Navegue na web com o navegador do DuiaOS
Exec=duiaos-ora %U
Icon=duiaos-ora
StartupWMClass=duiaos-ora
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
Keywords=navegador;internet;web;browser;sites;chromium;ora;
Actions=nova-janela;janela-privada;

[Desktop Action nova-janela]
Name=Nova janela
Exec=duiaos-ora --nova-janela

[Desktop Action janela-privada]
Name=Nova janela privada
Exec=duiaos-ora --privada
