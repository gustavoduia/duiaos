// DuiaOS — "Reiniciar no Windows" sem pedir senha a quem está no computador
// (sessão local e ativa: a pessoa na Tela de Entrada, na Tela de Bloqueio ou
// na sessão). Vale só para este serviço e só para iniciá-lo.
polkit.addRule(function (action, subject) {
    if (action.id === "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") === "duiaos-reiniciar-no-windows.service" &&
        action.lookup("verb") === "start" &&
        subject.local && subject.active) {
        return polkit.Result.YES;
    }
});
